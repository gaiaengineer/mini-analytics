<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{% block title %}Mini Analytics{% endblock %}</title>
<style>
  :root {
    --bg: #f8fafc;
    --surface: #ffffff;
    --border: #e5e7eb;
    --text: #0f172a;
    --muted: #64748b;
    --accent: #4f46e5;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text); }
  body {
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  header.site {
    padding: 20px 32px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: baseline; justify-content: space-between;
  }
  header.site h1 { margin: 0; font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
  header.site .crumbs { color: var(--muted); font-size: 13px; }

  main { max-width: 1200px; margin: 0 auto; padding: 24px 32px 48px; }

  h2.page-title { margin: 8px 0 4px; font-size: 22px; font-weight: 600; letter-spacing: -0.01em; }
  p.page-desc { margin: 0 0 24px; color: var(--muted); }

  /* KPI strip */
  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  .kpi {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 18px;
  }
  .kpi-label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
  .kpi-value { font-size: 24px; font-weight: 600; margin-top: 4px; letter-spacing: -0.01em; }
  .kpi-subtitle { color: var(--muted); font-size: 12px; margin-top: 4px; }

  /* Chart blocks */
  .blocks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(440px, 1fr));
    gap: 16px;
  }
  .block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    display: flex; flex-direction: column;
  }
  .block.wide { grid-column: 1 / -1; }
  .block-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px; border-bottom: 1px solid var(--border);
  }
  .block-title { font-size: 14px; font-weight: 600; }
  .block-desc { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .downloads { display: flex; gap: 8px; }
  .download-btn {
    font-size: 12px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    color: var(--text);
  }
  .download-btn:hover { background: var(--bg); text-decoration: none; border-color: #cbd5e1; }
  .block-body { padding: 8px 4px 4px; }

  /* Note block (methodology / data-quality callouts) */
  .note {
    background: #fff7ed;              /* warm ivory */
    border: 1px solid #fcd7a1;
    border-left: 4px solid #f59e0b;
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 16px;
    color: #5b4626;
  }
  .note-title {
    font-weight: 600;
    font-size: 13px;
    color: #92400e;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .note-body p { margin: 6px 0; font-size: 13px; line-height: 1.55; }
  .note-body p:first-child { margin-top: 0; }
  .note-body p:last-child { margin-bottom: 0; }
  .note-body code {
    background: #fef3c7;
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 12px;
  }
  .note-body strong { color: #78350f; }

  /* Data table block */
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .data-table th, .data-table td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--border); }
  .data-table th { background: var(--bg); color: var(--muted); font-weight: 500; }

  footer {
    max-width: 1200px; margin: 0 auto; padding: 24px 32px;
    color: var(--muted); font-size: 12px;
  }
</style>
</head>
<body>
<header class="site">
  <h1><a href="{{ home_href|default('../index.html') }}">Mini Analytics</a></h1>
  <div class="crumbs">Mini Analytics · demo data</div>
</header>
<main>
  {% block content %}{% endblock %}
</main>
<footer>
  Built {{ built_at }} · <a href="{{ home_href|default('../index.html') }}">All dashboards</a>
</footer>
</body>
</html>
